# Copy to .env and fill in. Never commit the real file.
VOICEPILOT_APP_TOKEN=change-me-to-a-long-random-string
DEEPGRAM_API_KEY=your-deepgram-key
# Optional
DEEPGRAM_MODEL=nova-3
VOICEPILOT_ENDPOINTING_MS=300
# Answers (milestone 2)
ANTHROPIC_API_KEY=your-anthropic-key
VOICEPILOT_ANSWER_MODEL=claude-opus-5-5
VOICEPILOT_ANSWER_EFFORT=low
